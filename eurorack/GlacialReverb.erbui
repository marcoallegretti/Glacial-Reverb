/*****************************************************************************

     GlacialReverb.erbui
     Simple freeze reverb UI

*Tab=3***********************************************************************/

module GlacialReverb {
   route manual
   board kivu12
   material pcb
   header {}
   footer {}

   // Row 1: top knobs (raised slightly)
   control fx_pot Pot {
      position 2.25hp, 17.5mm
      style rogan, 1ps
      label "FX"
   }

   control frozen_level_pot Pot {
      position 6hp, 17.5mm
      style rogan, 1ps
      label "FRZ LV"
   }

   control frozen_mix_pot Pot {
      position 9.75hp, 17.5mm
      style rogan, 1ps
      label "FRZ MX"
   }

   // Row 2 (raised slightly)
   control pre_delay_pot Pot {
      position 2.25hp, 35.5mm
      style rogan, 1ps
      label "PRE DL"
   }

   control decay_pot Pot {
      position 6hp, 35.5mm
      style rogan, 1ps
      label "DECAY"
   }

   // Row 3 (raised slightly)
   control mix_pot Pot {
      position 2.25hp, 58.5mm
      style rogan, 1ps
      label "MIX"
   }

   control duck_pot Pot {
      position 6hp, 58.5mm
      style rogan, 1ps
      label "DUCK"
   }

   // Row: freeze gate + buttons between pots and jacks
   control freeze_gate GateIn {
      position 2.25hp, 82.5mm
      style knurled
      label "FRZ G"
   }

   control freeze_button Button {
      position 6hp, 75.5mm
      style ck, d6r, black
      label "FRZ"
   }

   control freeze_led Led {
      position 6hp, 85.5mm
      style red
   }

   // ROOM (reverb model) selector button + RGB family-colour indicator
   control fx_button Button {
      position 9.75hp, 58.5mm
      style ck, d6r, black
      label "ROOM"
   }

   control fx_led LedRgb {
      position 9.75hp, 49.5mm
      style rgb
   }

   // Tail-FX selector button (red LED shows FX family as blink-count)
   control tank_button Button {
      position 9.5hp, 75.5mm
      style ck, d6r, black
      label "FX"
   }

   control tank_led Led {
      position 9.5hp, 85.5mm
      style red
   }

   // Row 4: CV inputs only
   control fx_cv CvIn {
      position 2.25hp, 97.5mm
      style knurled
      label "FX"
   }

   control frozen_level_cv CvIn {
      position 5hp, 97.5mm
      style knurled
      label "FRZ LV"
   }

   control mix_cv CvIn {
      position 7.5hp, 97.5mm
      style knurled
      label "MIX"
   }

   // ROOM-advance trigger (rising edge steps the room family)
   control tank_gate GateIn {
      position 9.75hp, 97.5mm
      style knurled
      label "ROOM"
   }

   // Row 5: audio I/O aligned under CV jacks: IN L, IN R, OUT L, OUT R
   control audio_in_left AudioIn {
      position 2.25hp, 111.5mm
      style knurled
      label "IN L"
   }

   control audio_in_right AudioIn {
      position 5hp, 111.5mm
      style knurled
      normalling audio_in_left
      label "IN R"
   }

   control audio_out_left AudioOut {
      position 7.5hp, 111.5mm
      style knurled
      label "OUT L"
   }

   control audio_out_right AudioOut {
      position 9.75hp, 111.5mm
      style knurled
      label "OUT R"
   }
}
